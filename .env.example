# Short share links (/api/share).
#
# Without these the endpoint answers 503 and the app falls back to long
# self-contained links that carry the record in the URL fragment, so local
# development needs no configuration (`npm run dev` serves an in-memory API).
#
# In production these are the Upstash Redis REST credentials:
# https://console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
